# XERQO — public_html/.htaccess
#   /api/...       -> Laravel (index.php)
#   /storage/...   -> uploaded files (symlink), or Laravel when symlinks aren't allowed
#   everything else -> the React app (index.html)

DirectoryIndex index.html
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (enable once the SSL certificate is active in cPanel → SSL/TLS Status)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Pass the bearer token through to PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # API -> Laravel
    RewriteRule ^api(/.*)?$ index.php [L]

    # Uploaded files: serve the real file if it exists, otherwise let Laravel find it
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^storage/ index.php [L]

    # Real files and folders (assets, images) are served as they are
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Every other address is a page of the React app
    RewriteRule ^ index.html [L]
</IfModule>

# Keep secrets and source files private
<FilesMatch "^(\.env.*|composer\.(json|lock)|package(-lock)?\.json|.*\.(log|sql|md))$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Header always set Strict-Transport-Security "max-age=31536000" (after HTTPS works)

    # built files have content hashes in their names: cache them for a year
    <FilesMatch "\.(js|css|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # the app shell must always be fresh so new deploys show up
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
