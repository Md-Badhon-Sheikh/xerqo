# XERQO — production settings for cPanel. Copy to /home/USER/xerqo/.env and fill in the blanks.
# Never commit the real .env.

APP_NAME=XERQO
APP_ENV=production
APP_KEY=                      # php artisan key:generate
APP_DEBUG=false               # must stay false: true shows errors and sign-in codes
APP_URL=https://xerqo.com
FRONTEND_URL=https://xerqo.com
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# cPanel → MySQL Databases: create the database and user, add the user with ALL PRIVILEGES.
# cPanel prefixes both names with your account name, e.g. cpuser_xerqo
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpuser_xerqo
DB_USERNAME=cpuser_xerqo
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database     # emails are queued; the cron job below sends them
CACHE_STORE=database

# public_html of this account — lets "php artisan storage:link" create public_html/storage
PUBLIC_HTML_PATH=/home/cpuser/public_html

# Email through the domain mailbox (cPanel → Email Accounts → Connect Devices shows these values)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.xerqo.com
MAIL_PORT=465
MAIL_USERNAME=hello@xerqo.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@xerqo.com"
MAIL_FROM_NAME="${APP_NAME}"

# Same-domain SPA with bearer tokens
SANCTUM_STATEFUL_DOMAINS=xerqo.com,www.xerqo.com
SANCTUM_TOKEN_PREFIX=xq_
SANCTUM_EXPIRATION=

# SMS: "reve" sends for real. The Reve keys, sender ID and SMS balance are entered by the
# Super Admin in Admin → Settings → SMS & Notifications (they are stored encrypted, not here).
SMS_DRIVER=reve

VITE_APP_NAME="${APP_NAME}"
